# Скопируйте в .env и задайте свои значения. Файл .env в git не попадает.

# PostgreSQL
POSTGRES_USER=artifact
POSTGRES_PASSWORD=change-me
POSTGRES_DB=artifact_repo

# MinIO (S3-хранилище артефактов)
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# RabbitMQ
RABBITMQ_USER=change-me
RABBITMQ_PASSWORD=change-me

# Подпись JWT-токенов (случайная строка от 32 символов)
JWT_SECRET=change-me-to-a-long-random-string

# Bootstrap-суперадмин (создаётся при первом старте; пароль минимум 12 символов)
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_PASSWORD=change-me-min-12-chars
